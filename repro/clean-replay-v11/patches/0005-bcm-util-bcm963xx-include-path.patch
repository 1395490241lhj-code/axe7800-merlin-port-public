--- a/release/src-rt-5.04axhnd.675x/router-sysdep.rt-axe7800/bcm_util/Makefile
+++ b/release/src-rt-5.04axhnd.675x/router-sysdep.rt-axe7800/bcm_util/Makefile
@@ -4,9 +4,19 @@
        bcm_boardutils.o bcm_ethswutils.o bcm_strutils.o
 
 CFLAGS += -Werror -Wfatal-errors -Wno-stringop-truncation -I$(HND_SRC)/router-sysdep/sys_util/ -I$(HND_SRC)/userspace/public/include/linux/ -I$(HND_SRC)/userspace/public/include/
-ifneq ($(strip $(BCM4906_504)),)
+# RT-AXE7800 replay fix: bcm_ethswutils.c includes "bcmnet.h", which lives in
+# $(HND_SRC)/bcmdrivers/opensource/include/bcm963xx/ and pulls in skb_defines.h and
+# bcmPktDma_defines.h from that same directory plus bcmtypes.h from
+# $(HND_SRC)/shared/opensource/include/bcm963xx/. Those are exactly the paths the line below
+# already names, but upstream gates them on BCM4906_504, which is unset for this target
+# (RTCONFIG_BCM4906_504 is not set), so the compile fails with
+#   bcm_ethswutils.c:47:10: fatal error: bcmnet.h: No such file or directory
+# The Broadcom-native entry point Bcmbuild.mk supplies the same two directories through
+# ALLOWED_INCLUDE_PATHS, but release/src/router/Makefile drives this component through the plain
+# Makefile instead. Applying the existing paths unconditionally is the smallest correction that
+# matches upstream intent; BCM4906_504 itself is deliberately NOT changed, and no header is
+# copied - the in-tree bcmnet.h is used where it already lives.
 CFLAGS += -I$(HND_SRC)/userspace/public/include/ -I$(HND_SRC)/bcmdrivers/opensource/include/bcm963xx/ -I$(HND_SRC)/shared/opensource/include/bcm963xx/
-endif
 
 # These are public API headers needed by other apps which want to call this lib.
 # Private/internal headers should not be listed here.
