+PHY_PREBUILT := prebuilt$(if $(wildcard $(CUR_DIR)/prebuilt/$(strip $(BRCM_CHIP))),/$(strip $(BRCM_CHIP)))
 DRV_DIR := ../../../shared/opensource/drv
 
