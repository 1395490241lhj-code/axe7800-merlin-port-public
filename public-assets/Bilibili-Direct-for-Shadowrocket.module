#!name=Bilibili DIRECT for Cheers
#!desc=For Apple TV Shadowrocket + Cheers. Force Bilibili API and video CDN traffic to DIRECT so FINAL,PROXY / DOMAIN-KEYWORD,aka,PROXY rules do not send Bilibili video streams through a proxy node.

[Rule]
DOMAIN-SUFFIX,bilibili.com,DIRECT
DOMAIN-SUFFIX,bilivideo.com,DIRECT
DOMAIN-SUFFIX,bilivideo.cn,DIRECT
DOMAIN-SUFFIX,bilicdn1.com,DIRECT
DOMAIN-SUFFIX,hdslb.com,DIRECT
DOMAIN-SUFFIX,biliapi.net,DIRECT
DOMAIN-WILDCARD,upos-*-mirrorakam.akamaized.net,DIRECT
